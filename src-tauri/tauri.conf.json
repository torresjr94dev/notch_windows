{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notch Windows",
  "version": "0.1.0",
  "identifier": "dev.notchwindows.island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jorge Torres",
    "copyright": "© 2026 Jorge Torres",
    "category": "Utility",
    "shortDescription": "Dynamic Island para Windows",
    "longDescription": "Una isla dinámica arriba al centro de la pantalla: música, avisos del sistema, micrófono y cámara, y Live Activities de Claude Code o tus scripts.",
    "homepage": "https://github.com/torresjr94dev/notch_windows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"]
      }
    }
  }
}
